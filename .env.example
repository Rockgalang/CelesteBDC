# Celeste BDC — environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase ---
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key: server-only, never exposed to the browser. Used for
# admin-level operations (signed URL generation, seed scripts, audit
# backfills). Keep out of NEXT_PUBLIC_* vars.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Direct Postgres connection string, used by the Supabase CLI / migration
# tooling and by scripts/seed-plans.ts. Project Settings -> Database.
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@celestebdc.com

# --- OCR (Phase 2, not used by Phase 0) ---
ANTHROPIC_API_KEY=

# --- App ---
# Base URL of this deployment, used for building absolute links in emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when
# invoking /api/cron/*. Vercel sets this automatically for cron-triggered
# requests when the env var is present — generate any random string and
# set it in the Vercel dashboard too.
CRON_SECRET=
